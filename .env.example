# Crokodial Dialer - Environment Variables
# Copy to .env and fill in values

# Backend API base URL (e.g. https://crokodial.com for production)
VITE_API_BASE=

# Calling uses the authenticated /api/dialer/voice-session endpoint.
# Never add Telnyx SIP passwords or private provider keys to VITE_* variables.

# Optional runtime source for the existing Quotes Compass engine (main process only).
# CROKODIAL_COMPASS_SOURCE=/path/to/quotes compass
