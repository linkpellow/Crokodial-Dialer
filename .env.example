# Crokodial Dialer - Environment Variables
# Copy to .env and fill in values

# Backend API base URL (defaults to https://crokodial.com when unset or blank)
VITE_API_BASE=https://crokodial.com

# Telnyx WebRTC SIP credentials (baked into renderer bundle at build time)
VITE_TELNYX_WEBRTC_USERNAME=
VITE_TELNYX_WEBRTC_PASSWORD=
