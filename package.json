{
  "name": "crokodial-dialer",
  "version": "1.0.0",
  "description": "Unified native Crokodial Dialer and Personal Assistant workspace",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run start:renderer\" \"npm run start:main\"",
    "start:main": "CROKODIAL_BUILD_MODE=development npm run build:main && wait-on http://localhost:5173 && CROKODIAL_RENDERER_URL=http://localhost:5173 electron .",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/write-platform-config.mjs",
    "build": "npm run build:main && vite build",
    "pack": "npm run build && electron-builder",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "start:renderer": "vite",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json",
    "stage:insurance": "node scripts/stage-compass.mjs",
    "test:native": "npm run build && node tests/native-workspace.test.cjs",
    "test:insurance": "node --test tests/compass-worker.test.cjs",
    "test:recording-bridge": "npm run build:main && node --test tests/recording-bridge.test.cjs"
  },
  "keywords": [
    "dialer",
    "telnyx",
    "webrtc",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@telnyx/webrtc": "^2.22.0",
    "events": "^3.3.0",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "playwright": "1.58.2",
    "typescript": "^5.6.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.crokodial.workspace",
    "productName": "Crokodial Workspace",
    "files": [
      "dist/**/*",
      "dist-renderer/**/*",
      "scripts/compass-worker.mjs"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Crokodial Workspace uses your microphone for calls and recordings you start in Notes."
      },
      "icon": "public/power-dialer.png",
      "category": "public.app-category.business",
      "target": "dmg"
    },
    "win": {
      "icon": "public/power-dialer.png",
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "resources/quotes-compass",
        "to": "quotes-compass",
        "filter": [
          "**/*",
          "!**/.env*",
          "!**/._*"
        ]
      }
    ]
  }
}
